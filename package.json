{
  "name": "gongfa-war",
  "private": true,
  "version": "0.1.0",
  "description": "攻伐战争 —— 区域征服 · 回合制 · 数字兵力",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm --workspace @gongfa-war/web run dev",
    "dev:server": "npm --workspace @gongfa-war/server run dev",
    "build": "npm --workspace @gongfa-war/web run build",
    "lan": "npm run build && npm --workspace @gongfa-war/server run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx scripts/balance.ts",
    "icons": "node scripts/gen-icons.mjs && node scripts/gen-android-icons.mjs",
    "android": "node scripts/build-android.mjs",
    "android:release": "node scripts/build-android.mjs --release",
    "android:keystore": "node scripts/gen-keystore.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
